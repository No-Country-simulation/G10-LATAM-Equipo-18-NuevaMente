# NuevaMente Backend — Environment Variables Template
# Copy this file as .env and fill in your keys. Never commit .env to git.

# ─── Environment & Runtime ─────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
# true permite storage_mock/ (recomendado en Supabase parcial para artefactos)
ALLOW_LOCAL_STORAGE=false
# 'oci' (flujo completo) | 'supabase' (modo parcial: solo documentos originales)
STORAGE_METHOD=oci

# ─── LLM APIs (Multi-Agent Ecosystem) ──────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# ─── Embedding APIs ───────────────────────────────────────────────────────────
JINA_API_KEY=
DEFAULT_GEMINI_MODEL_FLASH=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER_ORDER=gemini,jina,local

# ─── OCI Object Storage Always Free (mx-monterrey-1) ──────────────────────────
OCI_ENABLED=false
OCI_AUTH_MODE=instance_principal
OCI_REGION=mx-monterrey-1
OCI_NAMESPACE=
OCI_BUCKET_SOURCES=nuevamente-documentos-fuente
OCI_BUCKET_CONTENT=nuevamente-contenidos-educativos

# ─── Storage Quotas & Limits ──────────────────────────────────────────────────
STORAGE_MAX_UPLOAD_MB=25
STORAGE_USER_QUOTA_MB=200
STORAGE_SOFT_LIMIT_GIB=15

# ─── Supabase (modo parcial: documentos originales + metadata) ────────────────
# Requiere aplicar migrations/001_documents.sql y 003_documents_storage_backend.sql.
# NO aplicar 002_trash_system.sql en Supabase (es solo para SQLite).
# SUPABASE_KEY debe ser la service_role; nunca la anon/public.
# Los artefactos generados y los vectores aún NO se guardan en Supabase.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_DOCUMENTS=document-source
SUPABASE_BUCKET_ARTIFACTS=adapted-artifacts
