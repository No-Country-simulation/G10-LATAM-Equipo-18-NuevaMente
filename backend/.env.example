# NuevaMente Backend — Environment Variables Template
# Copy this file as .env and fill in your keys. Never commit .env to git.

# ─── LLM APIs (Multi-Agent Ecosystem) ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROK_API_KEY=your_grok_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# ─── Reranking & Hybrid Search APIs ───────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key_here

# ─── Embedding APIs ───────────────────────────────────────────────────────────
# Used when EMBEDDING_METHOD=api in config.py
JINA_API_KEY=your_jina_api_key_here

# ─── OCI Object Storage (Always Free) ─────────────────────────────────────────
# Leave empty to use local storage_mock/ fallback
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=
OCI_REGION=

# ─── Supabase ─────────────────────────────────────────
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_KEY=eyJh...   # service_role, no anon
