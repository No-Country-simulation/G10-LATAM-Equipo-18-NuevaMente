# NuevaMente Backend — Environment Variables Template
# Copy this file as .env and fill in your keys. Never commit .env to git.

# ─── LLM APIs (Multi-Agent Ecosystem) ──────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# ─── Embedding APIs ───────────────────────────────────────────────────────────
JINA_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER_ORDER=gemini,jina,local

# ─── Flags & Controls ─────────────────────────────────────────────────────────
ALLOW_DEMO_CONTENT=false
OCI_ENABLED=false

# ─── OCI Object Storage (Always Free - Disabled in local dev) ─────────────────
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=
OCI_REGION=

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
